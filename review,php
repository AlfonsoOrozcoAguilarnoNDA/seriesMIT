// Configuración básica
$directorioActual = __DIR__;
$scriptActual = basename(__FILE__);

// Obtener todos los archivos .php del directorio
$archivosPhp = glob($directorioActual . '/*.php');
?>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explorador de Scripts PHP</title>
    <!-- Bootstrap 4.6.2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <!-- Font Awesome 5.15.4 CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>
<body class="bg-light">

<div class="container my-5">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fab fa-php mr-2"></i>Archivos PHP en el directorio</h5>
            <span class="badge badge-light"><?php echo count($archivosPhp); ?> detectados</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th scope="col" class="text-center" style="width: 50px;">#</th>
                            <th scope="col">Archivo</th>
                            <th scope="col" class="text-center">Líneas</th>
                            <th scope="col" class="text-right">Tamaño</th>
                            <th scope="col" class="text-center" style="width: 120px;">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php 
                        $contador = 1;
                        foreach ($archivosPhp as $rutaArchivo): 
                            $nombreArchivo = basename($rutaArchivo);
                            
                            // Ignorar el propio script explorador
                            if ($nombreArchivo === $scriptActual) {
                                continue;
                            }

                            // Contar líneas de código
                            $lineas = count(file($rutaArchivo));

                            // Tamaño del archivo
                            $tamanoBytes = filesize($rutaArchivo);
                            if ($tamanoBytes >= 1048576) {
                                $tamanoFormateado = number_format($tamanoBytes / 1048576, 2) . ' MB';
                            } elseif ($tamanoBytes >= 1024) {
                                $tamanoFormateado = number_format($tamanoBytes / 1024, 2) . ' KB';
                            } else {
                                $tamanoFormateado = $tamanoBytes . ' B';
                            }
                        ?>
                            <tr>
                                <th scope="row" class="text-center align-middle"><?php echo $contador++; ?></th>
                                <td class="align-middle fw-bold">
                                    <i class="far fa-file-code text-primary mr-2"></i>
                                    <strong><?php echo htmlspecialchars($nombreArchivo); ?></strong>
                                </td>
                                <td class="text-center align-middle">
                                    <span class="badge badge-secondary"><?php echo number_format($lineas); ?> lin</span>
                                </td>
                                <td class="text-right align-middle text-muted">
                                    <small><?php echo $tamanoFormateado; ?></small>
                                </td>
                                <td class="text-center align-middle">
                                    <a href="<?php echo urlencode($nombreArchivo); ?>" class="btn btn-sm btn-outline-primary" target="_blank" title="Abrir archivo">
                                        <i class="fas fa-external-link-alt mr-1"></i> Entrar
                                    </a>
                                </td>
                            </tr>
                        <?php endforeach; ?>

                        <?php if ($contador === 1): ?>
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="fas fa-folder-open fa-2x mb-2 d-block"></i>
                                    No se encontraron otros archivos .php en este directorio.
                                </td>
                            </tr>
                        <?php endif; ?>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

